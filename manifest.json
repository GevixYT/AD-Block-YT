{
  "manifest_version": 3,
  "name": "AD-Block YT",
  "version": "1.1.11",
  "description": "Filters ad requests, hides sponsored placements, and skips recognized ads on YouTube.",
  "permissions": [
    "declarativeNetRequest"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "youtube_ads",
        "enabled": true,
        "path": "youtube-ads.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.youtube-nocookie.com/embed/*"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "css": [
        "youtube-ads.css"
      ],
      "js": [
        "skip-ads.js"
      ]
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.youtube-nocookie.com/embed/*"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN",
      "js": [
        "filter-player-ads.js"
      ]
    }
  ],
  "icons": {
    "16": "icons/ad-block-16.png",
    "32": "icons/ad-block-32.png",
    "48": "icons/ad-block-48.png",
    "128": "icons/ad-block-128.png"
  }
}
